# ==============================
# Core API (REST + Socket)
# ==============================
# Single origin used by all axios instances by default. Per-service URLs
# below fall back to VITE_API_URL when unset.
VITE_API_URL=http://localhost:5001

# Optional per-service overrides — leave commented to inherit VITE_API_URL.
# VITE_BASE_API_URL=
# VITE_BETA_API_URL=
# VITE_AUTH_API_URL=
# VITE_DATA_API_URL=
# VITE_PAYMENT_API_URL=
# VITE_STORAGE_API_URL=
# VITE_MEDIA_API_URL=
# VITE_CDN_URL=
# VITE_LOCKET_API_URL=https://api.locketcamera.com
# VITE_LOCKET_BETA_API_URL=
# VITE_EXPORTS_API_URL=
# VITE_CONVERTS_API_URL=
# VITE_EXTENS_API_URL=

# ==============================
# Public Keys (safe to ship to client)
# ==============================
VITE_PUBLIC_API_KEY=LKD-LOCKETLOVE-PUBLIC-KEY
VITE_VAPID_PUBLIC_KEY=
VITE_TURNSTILE_SITE_KEY=

# ==============================
# Feature Flags (default OFF for self-hosted)
# ==============================
# VITE_FEATURE_MUSIC=false
# VITE_FEATURE_COLLAB=false
