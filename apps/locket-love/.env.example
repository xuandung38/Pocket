# ==============================
# Core API (REST + Socket)
# ==============================
# Single origin used by all axios instances by default. Each VITE_*_API_URL
# below falls back to VITE_API_URL when unset — keeps single-origin
# self-hosted deployments dead simple.
VITE_API_URL=http://localhost:5001

# Per-service overrides — uncomment + set to split REST traffic across origins.
# Most users should leave these commented and use the single VITE_API_URL above.

# Primary REST + Socket origin override. Falls back to VITE_API_URL.
# VITE_BASE_API_URL=

# Beta server proxy origin. Falls back to VITE_API_URL.
# VITE_BETA_API_URL=

# Auth-only origin (login/logout/refresh-token). Falls back to VITE_API_URL.
# VITE_AUTH_API_URL=

# Data API origin (profile, friend, moments reads). Falls back to VITE_API_URL.
# VITE_DATA_API_URL=

# Payment service origin. Falls back to VITE_API_URL.
# VITE_PAYMENT_API_URL=

# Storage service origin for media uploads (R2 presigned). For self-hosted this
# MUST point to the storage service (default :5003), NOT the api service — image
# & video upload does POST {storage}/api/presignedV3 then PUTs the file to R2.
# If left blank it falls back to VITE_API_URL (the api service), whose presignedV3
# returns a Firebase resumable URL that fails to PUT from a self-hosted origin.
VITE_STORAGE_API_URL=http://localhost:5003

# Media (CDN) origin override. Falls back to VITE_API_URL.
# VITE_MEDIA_API_URL=

# Public CDN host for resolving asset URLs returned by the backend.
# VITE_CDN_URL=

# Upstream Locket Camera API host (proxied calls). Defaults to the public
# Locket origin when unset.
# VITE_LOCKET_API_URL=https://api.locketcamera.com

# Beta Locket Camera API host.
# VITE_LOCKET_BETA_API_URL=

# Exports / converts / extensions service hosts (rarely needed).
# VITE_EXPORTS_API_URL=
# VITE_CONVERTS_API_URL=
# VITE_EXTENS_API_URL=

# ==============================
# Public Keys (safe to ship to client)
# ==============================
# x-api-key header sent on every authenticated request. The self-hosted
# backend uses this to identify the client app.
VITE_PUBLIC_API_KEY=LKD-LOCKETLOVE-PUBLIC-KEY

# Web-Push VAPID public key — required only if the backend pushes notifications.
VITE_VAPID_PUBLIC_KEY=

# Cloudflare Turnstile site key — enables captcha on login. Leave empty to
# disable captcha (backend must also allow uncaptcha'd login).
VITE_TURNSTILE_SITE_KEY=

# ==============================
# Feature Flags (default OFF for self-hosted)
# ==============================
# Enable only when the backend implements the corresponding routes.

# Music overlay metadata via /api/getInfoMusic.
# VITE_FEATURE_MUSIC=false

# Collab caption lookup via /api/collab/getCaption.
# VITE_FEATURE_COLLAB=false
