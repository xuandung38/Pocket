NODE_ENV=Development
PORT=5001

# CORS — NOTE: currently NOT enforced. app.js uses `origin: true` (reflects any
# origin) so the API accepts requests from localhost, LAN IPs, any host. This var
# is kept only for reference / future re-tightening. To restrict again, switch
# app.js back to an allowlist built from this list.
# 5173/5175/5176 = Vite dev defaults; 8173/8175/8176 = docker-compose host ports.
CORS_ORIGIN=http://localhost:5173,http://localhost:5175,http://localhost:5176,http://localhost:8173,http://localhost:8175,http://localhost:8176

# Base API của Locket (reverse / private API)
LOCKET_API_BASE=

# ================== FIREBASE ==================

# API Key Firebase (Auth, AppCheck, Identity Toolkit…)
FIREBASE_API_KEY=

# Firebase Authentication (Identity Toolkit API v1)
# Dùng cho: signIn, signUp, verifyPhoneNumber, refresh token...
# NOTE: v3 (www.googleapis.com/identitytoolkit/v3) đã deprecated, dùng v1 bên dưới
FIREBASE_AUTH_API_BASE=https://identitytoolkit.googleapis.com/v1/

# Firebase Firestore REST API base
# Dùng cho: đọc/ghi document qua REST
FIREBASE_FIRESTORE_API_BASE=

# Firebase App Check API
# Dùng cho: verify / exchange App Check token
FIREBASE_APPCHECK_API_BASE=

# Firebase Secure Token API
# Dùng cho: refresh access token từ refresh token
FIREBASE_SECURETOKEN_API_BASE=https://securetoken.googleapis.com/

FIRESTORE_DEFAULT=

# ================== INTEGRATIONS ==================

# WeatherAPI.com API key — dùng cho /api/weatherV2
# Đăng ký miễn phí tại https://www.weatherapi.com/
WEATHER_API_KEY=