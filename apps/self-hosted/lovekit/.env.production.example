# Production env template for the lovekit Vite app.
# Copy to `.env.production` and fill in the real values for your deployment.

# Single API origin used by all axios instances (REST + Socket).
# In production docker-compose, `api` is the service hostname.
VITE_API_URL=http://api:5001

# Optional: legacy/per-service overrides — fall back to VITE_API_URL when unset.
# Beta server proxy origin. Consumed by `axios.exten` + beta server fetches
# (e.g. fetchUserByData / sendCelebrityRequestV2).
# VITE_BETA_API_URL=https://api-beta.locket-dio.com
# VITE_BASE_API_URL=
# VITE_AUTH_API_URL=
# VITE_DATA_API_URL=
# VITE_PAYMENT_API_URL=
# VITE_STORAGE_API_URL=
# VITE_LOCKET_API_URL=https://api.locketcamera.com
# VITE_EXPORTS_API_URL=
# VITE_CONVERTS_API_URL=
# VITE_EXTENS_API_URL=

# Public client identifiers — replace with real production keys before deploy.
VITE_PUBLIC_API_KEY=LKD-LOVEKIT-PUBLIC-KEY
VITE_VAPID_PUBLIC_KEY=
VITE_TURNSTILE_SITE_KEY=

# Optional feature flags — default OFF for self-hosted (endpoints not implemented).
# Enable only if your backend exposes the corresponding routes.
# VITE_FEATURE_MUSIC=false   # /api/getInfoMusic — music overlay metadata
# VITE_FEATURE_COLLAB=false  # /api/collab/getCaption — collab caption lookup
