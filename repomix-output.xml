                          {" "}
                          #{t}{" "}
                        </span>
                      ))}{" "}
                    </div>
                  )}
                  {/* Description */}
                  <p className="text-sm text-base-content/70 line-clamp-3 mb-4 flex-1">
                    {n.description}
