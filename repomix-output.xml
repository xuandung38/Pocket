  const friendList = useFriendStoreV3((s) => s.friendList);
  const friendDetailsMap = useFriendStoreV3((s) => s.friendDetailsMap);
  const friendRelationsMap = useFriendStoreV3((s) => s.friendRelationsMap);

  return useMemo(() => {
