  try {
    if (!friend?.uid) return;
    // lưu ID
    await friendDB.friendIds.put({
      uid: friend.uid,
      createdAt: friend.createdAt || Date.now(),
    });
    // lưu chi tiết
    await friendDB.friendDetails.put(friend);
