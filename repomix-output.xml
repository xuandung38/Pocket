                        <span className="font-semibold text-gray-700">
                          {item.downloads}
                        </span>
                      </div>
                    </div>
                  </div>

                  {/* Actions */}
                  <div className="flex gap-2">
                    <button
                      className={`flex-1 px-4 py-2.5 rounded-xl text-base font-semibold transition-all duration-300 transform hover:scale-105 ${
