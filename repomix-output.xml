  try {
    const res = await instanceMain.post("api/coupon/validate", {
      code,
      planId,
    });
    return handleCouponResponse(res?.data);
  } catch (error) {
    console.error("Lỗi khi kiểm tra coupon:", error);
    return {
      valid: false,
      message: "Không thể kiểm tra mã giảm giá",
