                <X className="mr-1" /> Huỷ
              </button>

              <button onClick={handleConfirm} className="btn btn-primary">
                <Scissors className="mr-1" /> Lưu vùng cắt
              </button>
            </div>
          </div>
        </div>
      )}
    </>
  );
};

export default CropVideoStudio;
