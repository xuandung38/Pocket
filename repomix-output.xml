  DISABLED: "Mã giảm giá đã bị vô hiệu hóa",
  EXPIRED: "Mã giảm giá đã hết hạn",
  PLAN_NOT_ALLOWED: "Mã giảm giá không áp dụng cho gói này",
  AUTH_REQUIRED: "Vui lòng đăng nhập để sử dụng mã",
